<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;netstandard2.0;net6.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Package Metadata -->
    <Title>SmartProxyManager.Core</Title>
    <PackageId>SmartProxyManager.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>Musoftware</Authors>
    <Company>Musoftware</Company>
    <Description>The core engine for SmartProxyManager. Supports HTTP and SOCKS5 proxies, intelligent multi-format parsing, thread-safe rotation, parallel testing, and HttpClientHandler creation.</Description>
    <PackageTags>winforms;proxy;http-proxy;socks5;proxy-manager;csharp;proxy-checker;proxy-rotator</PackageTags>
    <RepositoryUrl>https://github.com/Musoftware/SmartProxyManager</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HttpToSocks5Proxy" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462' Or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
